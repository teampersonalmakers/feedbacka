rules_version = '2';

// Personalmakers AI — Firestore 보안 규칙
//
// 접근 자격: 구글 로그인 + directors/{이메일} 문서 존재 (디렉터 화이트리스트).
//
// 예외가 하나 있다: 아래 OWNER 이메일은 화이트리스트가 비어 있어도 항상 통과한다.
// 최초 부트스트랩용이자 잠금 해제(break-glass) 장치다 — 이게 없으면 directors
// 컬렉션이 빈 상태에서 아무도(소유자 포함) 로그인할 수 없다.
// 규칙에 박혀 있으므로 서버에서 강제되고, 클라이언트 조작으로는 뚫리지 않는다.
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ 소유자 계정. 바꾸려면 이 줄과 storage.rules, public/firebase.js 의
    //    OWNER_EMAILS 를 함께 수정할 것.
    function isOwnerAccount() {
      return request.auth.token.email == 'comingssoni@gmail.com';
    }

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function dirPath() {
      return /databases/$(database)/documents/directors/$(request.auth.token.email);
    }

    // 화이트리스트에 있고 active 가 false 가 아닌 계정.
    function listedDirector() {
      return exists(dirPath()) && get(dirPath()).data.get('active', true) == true;
    }

    function isDirector() {
      return signedIn() && (isOwnerAccount() || listedDirector());
    }

    // 커밍쏜 본인만. admin 역할을 가진 디렉터도 통과하지 못한다.
    // '내부 인사이트'(지식베이스 원문 자산)는 이 계정만 본다.
    function isOwnerOnly() {
      return signedIn() && isOwnerAccount();
    }

    // 소유자, 또는 role 이 admin 인 디렉터. 화이트리스트를 관리할 수 있다.
    function isAdmin() {
      return signedIn()
        && (isOwnerAccount()
            || (listedDirector() && get(dirPath()).data.get('role', 'director') == 'admin'));
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 한 번에 밀어넣는 양을 제한해 사고성 대량 쓰기를 막는다.
    function sizeOk() {
      return request.resource.data.size() < 40;
    }

    // ── 디렉터 화이트리스트 ────────────────────────────────────────────────
    // 문서 ID = 소문자 이메일. 일반 디렉터는 본인 항목만 확인할 수 있고,
    // admin 만 목록 조회와 추가·삭제를 할 수 있다.
    match /directors/{docId} {
      allow read: if signedIn() && (docId == request.auth.token.email || isAdmin());

      allow create, update: if isAdmin()
        && request.resource.data.email == docId
        && docId == docId.lower()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.get('role', 'director') in ['director', 'admin']
        && sizeOk();

      allow delete: if isAdmin();
    }

    // ── 디렉터 개인 데이터 ─────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) && isDirector();
      allow create, update: if isOwner(uid) && isDirector() && sizeOk()
        && (!('nickname' in request.resource.data)
            || (request.resource.data.nickname is string
                && request.resource.data.nickname.size() > 0
                && request.resource.data.nickname.size() <= 20));
      allow delete: if false;

      // 대화 목록
      match /convs/{convId} {
        allow read, delete: if isOwner(uid) && isDirector();
        allow create, update: if isOwner(uid) && isDirector() && sizeOk()
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.student is string
          && request.resource.data.student.size() <= 100
          && request.resource.data.get('cohort', '') is string
          && request.resource.data.get('cohort', '').size() <= 10;

        // 대화 안의 턴
        match /turns/{turnId} {
          allow read, delete: if isOwner(uid) && isDirector();
          allow create, update: if isOwner(uid) && isDirector() && sizeOk()
            && request.resource.data.seq is int
            && request.resource.data.q is string
            && request.resource.data.q.size() <= 60000
            && (request.resource.data.a == null ||
                (request.resource.data.a is string && request.resource.data.a.size() <= 200000));
        }
      }

      // classic.html 피드백 기록
      match /records/{recordId} {
        allow read, delete: if isOwner(uid) && isDirector();
        allow create, update: if isOwner(uid) && isDirector() && sizeOk()
          && request.resource.data.mission is string
          && request.resource.data.mission.size() <= 60000
          && request.resource.data.answer is string
          && request.resource.data.answer.size() <= 200000;
      }
    }

    // ── 플레이북 (앱에서 디렉터가 직접 작성 / 커밍쏜이 승인) ───────────────
    //
    // 상태가 '승인'이 되면 api/feedback.js 가 그 Q&A 를 시스템 프롬프트에 넣는다.
    // 즉 승인 권한 = AI 행동을 바꾸는 권한이다. 그래서 승인은 admin 전용이고,
    // 이미 승인된 문서를 일반 디렉터가 수정하는 것도 막는다.
    match /playbook/{id} {

      function validPlaybook() {
        return request.resource.data.question is string
          && request.resource.data.question.size() > 0
          && request.resource.data.question.size() <= 500
          && request.resource.data.answer is string
          && request.resource.data.answer.size() <= 200000
          && request.resource.data.get('originalQuestion', '') is string
          && request.resource.data.get('originalQuestion', '').size() <= 60000
          && request.resource.data.status in ['대기', '답변작성', '승인', '보류', '자동기록']
          && request.resource.data.get('category', '') is string
          && request.resource.data.get('director', '') is string
          && request.resource.data.get('director', '').size() <= 50
          && request.resource.data.get('student', '') is string
          && request.resource.data.get('student', '').size() <= 100
          && request.resource.data.get('cohort', '') is string
          && request.resource.data.get('cohort', '').size() <= 10
          && request.resource.data.get('consultDate', '') is string
          && request.resource.data.get('consultDate', '').size() <= 10
          && sizeOk();
      }

      allow read: if isDirector();

      // 일반 디렉터: 초안 작성과 수정. 승인 상태는 만들 수도, 바꿀 수도 없다.
      allow create: if isDirector() && validPlaybook()
        && request.resource.data.status in ['대기', '답변작성', '보류'];
      allow update: if isDirector() && validPlaybook()
        && resource.data.status != '승인'
        && request.resource.data.status != '승인';

      // 커밍쏜(admin): 승인·보류 전환과 답변 조정, 삭제
      allow create, update: if isAdmin() && validPlaybook();
      allow delete: if isAdmin();
    }

    // ── 그 밖의 팀 지식 (서버 전용) ────────────────────────────────────────
    // 지침 / 디렉팅 사례 / KB 소스 / 평가 / 자동기록.
    // 서버(Admin SDK)는 규칙을 우회하므로 api/*.js 는 정상 동작하고,
    // 브라우저에서는 읽기·쓰기 모두 막힌다. 커밍쏜의 컨설팅 자산이
    // 클라이언트로 새어나가지 않게 하기 위해서다.
    // ── AI 지침 / 디렉팅 사례 — 설정 페이지에서 커밍쏜만 편집 ──────────────
    // 여기 내용이 곧 시스템 프롬프트다. admin 디렉터도 열지 않는다.
    match /guidelines/{id} {
      allow read: if isOwnerOnly();
      allow create, update: if isOwnerOnly()
        && request.resource.data.section in ['persona', 'philosophy', 'tone', 'format', 'freeGuide', 'doNotDo', 'category']
        && request.resource.data.body is list
        && request.resource.data.active is bool
        && sizeOk();
      allow delete: if isOwnerOnly();
    }
    match /cases/{id} {
      allow read: if isOwnerOnly();
      allow create, update: if isOwnerOnly()
        && request.resource.data.summary is string
        && request.resource.data.summary.size() > 0
        && request.resource.data.summary.size() <= 300
        && request.resource.data.get('body', '') is string
        && request.resource.data.aiApplied is bool
        && sizeOk();
      allow delete: if isOwnerOnly();
    }
    match /ratings/{id}    { allow read, write: if false; }
    match /history/{id}    { allow read, write: if false; }
    match /metrics/{id}    { allow read, write: if false; }
    match /chunks/{id}     { allow read, write: if false; }   // 벡터 청크 — 서버(findNearest)만
    match /evals/{id}      { allow read, write: if false; }   // 자동 평가 결과 — /api/eval 로만
    match /distill/{id}    { allow read, write: if false; }   // 녹취 증류 진행 상태 — /api/distill 로만

    // ── 지식베이스 원문 (내부 인사이트) ────────────────────────────────────
    // 유튜브 자막·컨설팅 전문이 담긴 원본 자산. 디렉터에게도 열지 않는다.
    // 커밍쏜 본인 계정만 읽고 쓴다.
    match /kbSources/{id} {
      allow read: if isOwnerOnly();
      allow create, update: if isOwnerOnly()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 300
        && request.resource.data.get('transcript', '') is string
        && sizeOk();
      allow delete: if isOwnerOnly();
    }

    // 위에서 명시하지 않은 경로는 전부 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
